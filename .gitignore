@'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets - NEVER COMMIT!
.env
.env.local
*.key
secrets.toml
.streamlit/secrets.toml

# Test outputs
*.json
*.md
!README.md
*.html
!templates/*.html
test-result*
quadratic*
transcript*
output*
smart-output*
*-result*

# Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Models (large files)
*.pdparams
*.onnx
*.pth
*.pt
.paddleocr/

# Logs
*.log
'@ | Out-File -FilePath .gitignore -Encoding utf8